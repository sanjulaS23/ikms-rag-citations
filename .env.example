LLM_EMBEDDING_MODEL=text-embedding-3-small

# Vector database
VECTOR_DB=pinecone
VECTOR_DB_URL=
VECTOR_DB_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX=
PINECONE_ENV=
PINECONE_NAMESPACE=default

# Logging
LOG_LEVEL=INFO
